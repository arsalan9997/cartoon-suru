<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cartoon World</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

<header class="hero">
    <div class="container">
        <h1>🎨 Cartoon World</h1>
        <p>Welcome to the colorful world of your favorite cartoons!</p>
        <a href="#cartoons" class="btn">Explore Cartoons</a>
    </div>
</header>

<main class="container" id="cartoons">
    <h2>⭐ Popular Cartoons</h2>

    <section class="cards">

        <article class="card">
            <div class="emoji">🐱</div>
            <h3>Tom & Jerry</h3>
            <p>A classic cat and mouse adventure full of comedy, action and fun.</p>
            <div class="rating">⭐⭐⭐⭐⭐</div>
        </article>

        <article class="card">
            <div class="emoji">🐶</div>
            <h3>Dog Adventure</h3>
            <p>Join a friendly dog on exciting adventures with amazing friends.</p>
            <div class="rating">⭐⭐⭐⭐</div>
        </article>

        <article class="card">
            <div class="emoji">🐼</div>
            <h3>Kung Fu Panda</h3>
            <p>A funny panda discovers courage, friendship and the power within.</p>
            <div class="rating">⭐⭐⭐⭐⭐</div>
        </article>

        <article class="card">
            <div class="emoji">🦸</div>
            <h3>Super Hero</h3>
            <p>A colorful hero protects the city while learning important lessons.</p>
            <div class="rating">⭐⭐⭐⭐</div>
        </article>

        <article class="card">
            <div class="emoji">🐭</div>
            <h3>Mickey Mouse</h3>
            <p>A cheerful character bringing friendship, laughter and imagination.</p>
            <div class="rating">⭐⭐⭐⭐⭐</div>
        </article>

        <article class="card">
            <div class="emoji">🦁</div>
            <h3>Lion King</h3>
            <p>An inspiring journey about family, responsibility and becoming a leader.</p>
            <div class="rating">⭐⭐⭐⭐⭐</div>
        </article>

    </section>

    <div class="server-box">
        <h2>🚀 DevOps Deployment Demo</h2>
        <p>GitHub → Maven → WAR → AWS EC2 → Tomcat 10</p>
        <a href="hello" class="btn secondary">Test Java Servlet</a>
    </div>
</main>

<footer>
    <p>© 2026 Cartoon World | Java + Maven + Tomcat</p>
</footer>

</body>
</html>
